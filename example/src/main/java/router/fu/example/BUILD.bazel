load("@rules_closure//closure:defs.bzl", "closure_js_library")
load("//tools/browser:java.bzl", "java_j2cl_library")

package(default_visibility = ["//visibility:public"])

java_j2cl_library(
    name = "app",
    srcs = [
        "AppState.java",
        "AuthState.java",
        "Example.java",
        "MyRouter.java",
        "package-info.java",
    ],
    plugins = [
        "//:router_fu_processor_plugin",
        "@arez//:arez_processor_plugin",
    ],
    deps = [
        "//:core",
        "//third_party/java:jsinterop_annotations-j2cl",
        "@arez//:core-j2cl",
    ],
)

closure_js_library(
    name = "entry",
    srcs = ["entry.js"],
    deps = [":app"],
)
