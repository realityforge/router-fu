load("@rules_closure//closure:defs.bzl", "closure_js_library")
load("//tools/browser:java.bzl", "java_j2cl_library")
load("//tools/browser:rules.bzl", "browser_application")

package(default_visibility = ["//visibility:public"])

java_j2cl_library(
    name = "app",
    srcs = glob(["src/main/java/**/*.java"]),
    java_deps = [
        "//:core",
        "//third_party/java:arez_core",
        "//third_party/java:jsinterop_annotations",
    ],
    plugins = [
        "//:router_fu_processor_plugin",
        "@arez//:arez_processor_plugin",
    ],
    deps = [
        "//:core-j2cl",
        "//third_party/java:jsinterop_annotations-j2cl",
        "//third_party/java:jspecify-j2cl",
        "@arez//:core-j2cl",
    ],
)

alias(
    name = "java",
    actual = ":app_java",
)

closure_js_library(
    name = "entry",
    srcs = ["src/main/java/router/fu/example/entry.js"],
    deps = [":app"],
)

browser_application(
    name = "example",
    entry_point = "router.fu.example.Main",
    html = "src/main/webapp/example.html",
    deps = [":entry"],
)
