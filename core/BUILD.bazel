load("//third_party/java:rules.bzl", "java_library", "java_testng")

package(default_visibility = ["//visibility:public"])

java_library(
    name = "core",
    srcs = glob(["src/main/java/**/*.java"]),
    deps = [
        "//third_party/java:base",
        "//third_party/java:braincheck_core",
        "//third_party/java:jsinterop_annotations",
    ],
)

java_testng(
    name = "tests",
    srcs = glob(["src/test/java/**/*.java"]),
    jvm_flags = ["-Dbraincheck.environment=development"],
    test_classes = ["router.fu." + name + "Test" for name in [
        "Location",
        "Parameter",
        "RouteState",
        "Route",
        "Router",
        "Segment",
    ]],
    deps = [
        ":core",
        "//third_party/java:braincheck_core",
    ],
)
