load("//third_party/java:rules.bzl", "java_testng")

package(default_visibility = ["//visibility:public"])

java_testng(
    name = "tests",
    srcs = glob(["*.java"]),
    jvm_flags = ["-Dbraincheck.environment=development"],
    test_classes = ["router.fu." + name + "Test" for name in [
        "Location",
        "Parameter",
        "RouteState",
        "Route",
        "Router",
        "Segment",
    ]],
    deps = [
        "//core/src/main/java/router/fu:core",
        "//third_party/java:braincheck_core",
    ],
)
