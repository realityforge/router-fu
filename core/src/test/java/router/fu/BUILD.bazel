)

j2cl_junit_test(
    name = "RouterTest",
    test_class = "router.fu.RouterTest",
    runtime_deps = [":test_classes"],
)

j2cl_junit_test(
    name = "SegmentTest",
    test_class = "router.fu.SegmentTest",
    runtime_deps = [":test_classes"],
)

test_suite(
