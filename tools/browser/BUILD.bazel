load("@rules_closure//closure:defs.bzl", "closure_js_library", "custom_browser")

config_setting(
    name = "production",
    values = {"compilation_mode": "opt"},
    visibility = [
        "//browser/src/test/js/router.fu:__pkg__",
        "//core/src/test/java/router/fu:__pkg__",
        "//example/src/main/webapp:__pkg__",
        "//tools/release/src/test/java/router/fu/tools/release/consumer:__pkg__",
    ],
)

closure_js_library(
    name = "mode",
    testonly = True,
    srcs = ["mode.js"],
    visibility = [
        "//browser/src/test/js/router.fu:__pkg__",
    ],
)

# Chromium otherwise writes chrome_debug.log beside its downloaded executable on macOS.
custom_browser(
    name = "chromium",
    browser = "@rules_browsers//browsers/chromium:chromium",
    metadata = "chromium.json",
    visibility = [
        "//browser/src/test/js/router.fu:__pkg__",
        "//core/src/test/java/router/fu:__pkg__",
        "//tools/release/src/test/java/router/fu/tools/release/consumer:__pkg__",
    ],
)
