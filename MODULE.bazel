# Own the shared browser compiler/tool dependencies rather than inheriting a
# transitive module's partial Maven lock.
browser_maven = use_extension("@rules_jvm_external//:extensions.bzl", "maven")
browser_maven.install(
    artifacts = ["org.jspecify:jspecify:1.0.1"],
    duplicate_version_warning = "none",
    fail_if_repin_required = True,
    known_contributing_modules = [
        "braincheck",
        "j2cl",
        "jsinterop_base",
        "protobuf",
        "rules_closure",
    ],
    lock_file = "//:maven_install.json",
    repositories = ["https://repo.maven.apache.org/maven2"],
)
use_repo(browser_maven, "maven")

